{
  "name": "table-goblin",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "node scripts/launch.cjs",
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build && node scripts/build-server.cjs",
    "start:online": "node scripts/room-server.cjs",
    "test:online": "npm run build && node tests/online.cjs",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:browser": "npm run build && node tests/browser.cjs"
  },
  "dependencies": {
    "cannon-es": "^0.20.0",
    "gifuct-js": "^2.1.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "playwright": "^1.64.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.0"
  }
}
